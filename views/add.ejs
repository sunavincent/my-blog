<%- include("partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="container">
    <header class="d-flex flex-wrap justify-content-around align-items-center py-3 mb-4 border-bottom">
      
  
  
      <ul class="nav nav-pills">
        <li class="nav-item">
          <a href="/" class="nav-link active" aria-current="page" style="background-color: #343a40; color: white">HOME</a>
        </li>
        <li class="nav-item">
          <a href="/add" class="nav-link" style="color: #343a40">Add New</a>
        </li>
      </ul>
    </header>
  </div>
    <main class="container">
        <form action="/add" method="POST">
          <h1 class="h3 mb-3 fw-normal">Add New Post</h1>
          
          <div class="form-floating mb-3">
            <input type="text" class="form-control" name="title" id="floatingTitle" placeholder="Title" required>
            <label for="floatingTitle">Title</label>
          </div>
      
          <div class="form-floating mb-3">
            <textarea class="form-control" name="content" id="floatingContent" placeholder="Content" required style="height: 200px"></textarea>
            <label for="floatingContent">Content</label>
          </div>
      
          <button class="w-100 btn btn-lg btn-primary" type="submit" style="background-color: #343a40; color: white">Save</button>
        </form>
      </main>
</div>
<%- include("partials/footer.ejs") %>
</body>
</html>
