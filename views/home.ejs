<%- include("partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suna' Blog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="container">
    <header class="d-flex flex-wrap justify-content-around align-items-center py-3 mb-4 border-bottom">
      
  
  
      <ul class="nav nav-pills">
        <li class="nav-item">
          <a href="/" class="nav-link active" aria-current="page" style="background-color: #343a40; color: white">HOME</a>
        </li>
        <li class="nav-item">
          <a href="/add" class="nav-link" style="color: #343a40">Add New</a>
        </li>
      </ul>
    </header>
  </div>
      
      
<div class="container">
    <% articles.forEach((article, index) => { %>
        <div class="article">
            <h2><%= article.title %></h2>
            <p><%= article.content %></p>
            <a href="#" class="btn">Edit</a>
            <a href="#" class="btn">Delete</a>
        </div>
    <% }); %>
</div>

</div>

</body>
</html>

<%- include("partials/footer.ejs") %>